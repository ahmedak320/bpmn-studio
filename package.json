{
  "name": "orbitpm-process-studio-lite",
  "version": "0.4.5",
  "description": "OrbitPM Process Studio Lite — a self-contained, bilingual BPMN 2.0 editor that runs in the browser.",
  "license": "MIT",
  "homepage": "https://ahmedak320.github.io/bpmn-studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedak320/bpmn-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ahmedak320/bpmn-studio/issues"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean:dist": "node scripts/clean-output.mjs dist",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings 0",
    "check:actions": "node scripts/check-actions.mjs",
    "check:lock": "node scripts/check-lockfile.mjs",
    "check:lite-only": "node scripts/check-lite-only.mjs",
    "check:no-skips": "node scripts/check-no-skips.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "check:attribution": "node scripts/check-bpmn-attribution.mjs",
    "check:ui-copy": "node --experimental-strip-types scripts/check-hardcoded-ui-copy.ts",
    "check:size": "node scripts/check-artifact-size.mjs",
    "license:check": "node scripts/license-policy.mjs",
    "sbom": "node scripts/generate-sbom.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --maxWorkers=4 --retry=0 --reporter=default --reporter=./scripts/vitest-release-reporter.mjs",
    "test:coverage": "node scripts/run-coverage.mjs",
    "test:validation": "vitest run --maxWorkers=4 --retry=0 --reporter=default --reporter=./scripts/vitest-release-reporter.mjs src/validation/__tests__ src/generation/__tests__/generation-safety.test.ts src/generation/__tests__/ir-validation.test.ts && node scripts/bpmn-fixture-gate.mjs",
    "test:archives": "vitest run --maxWorkers=4 --retry=0 --reporter=default --reporter=./scripts/vitest-release-reporter.mjs src/security src/ai/__tests__/docx.test.ts src/library/__tests__/zip.test.ts src/spreadsheet/xlsxPreflight.test.ts src/spreadsheet/csv.test.ts",
    "test:performance": "vite-node scripts/performance-gate.ts",
    "test:performance:browser": "vite-node scripts/browser-performance-gate.ts",
    "test:soak": "vite-node scripts/soak-gate.ts",
    "test:e2e:built": "playwright test",
    "test:e2e": "npm run clean:dist && npm run build && npm run test:e2e:built",
    "test:a11y": "node scripts/accessibility-audit.mjs",
    "release:assemble": "node scripts/assemble-release.mjs",
    "release:verify": "node scripts/verify-release.mjs",
    "release:file-smoke": "node scripts/file-smoke.mjs"
  },
  "dependencies": {
    "@bpmn-io/properties-panel": "3.47.0",
    "bpmn-auto-layout": "0.4.0",
    "bpmn-js": "18.21.0",
    "bpmn-js-bpmnlint": "0.24.0",
    "bpmn-js-create-append-anything": "1.3.1",
    "bpmn-js-properties-panel": "5.61.0",
    "bpmn-moddle": "9.0.4",
    "bpmnlint": "11.12.1",
    "diagram-js": "15.22.0",
    "diagram-js-minimap": "5.4.0",
    "fflate": "0.8.3",
    "jspdf": "4.2.1",
    "papaparse": "5.5.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "read-excel-file": "9.3.4",
    "tiny-svg": "4.1.4",
    "xmllint-wasm": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.1",
    "@types/node": "22.20.1",
    "@types/papaparse": "5.5.2",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "3.2.7",
    "eslint": "10.0.1",
    "eslint-plugin-react-hooks": "7.1.1",
    "github-actionlint": "1.7.12",
    "globals": "17.7.0",
    "jsdom": "29.1.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.65.0",
    "vite": "6.4.3",
    "vite-node": "3.2.4",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  },
  "overrides": {
    "adm-zip": "0.6.0",
    "test-exclude": "8.0.0"
  }
}
