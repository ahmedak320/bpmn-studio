{
  "name": "orbitpm-process-studio-lite",
  "version": "0.4.5",
  "description": "OrbitPM Process Studio Lite — a self-contained, bilingual BPMN 2.0 editor that runs in the browser.",
  "license": "MIT",
  "homepage": "https://ahmedak320.github.io/bpmn-studio/",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahmedak320/bpmn-studio.git"
  },
  "bugs": {
    "url": "https://github.com/ahmedak320/bpmn-studio/issues"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22 <23",
    "npm": ">=11 <12"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check:lite-only": "node scripts/check-lite-only.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.18",
    "@ai-sdk/google": "4.0.21",
    "@bpmn-io/properties-panel": "3.47.0",
    "ai": "7.0.34",
    "bpmn-auto-layout": "0.4.0",
    "bpmn-js": "18.21.0",
    "bpmn-js-create-append-anything": "1.3.1",
    "bpmn-js-properties-panel": "5.61.0",
    "bpmn-moddle": "9.0.4",
    "diagram-js": "15.22.0",
    "diagram-js-minimap": "5.4.0",
    "fflate": "0.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tiny-svg": "4.1.4",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "3.2.7"
  }
}
